<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:paddingBottom="32dp">

        <!-- Card: Compose -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/divider"
            app:strokeWidth="1dp"
            app:contentPadding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView style="@style/SectionTitle" android:text="创作 Compose" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="提示词预设 · tap to choose"
                    android:textSize="12sp"
                    android:textColor="@color/primary" />
                <Spinner
                    android:id="@+id/spinnerCaptionPreset"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:background="@drawable/preset_spinner_bg"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp" />
                <TextView style="@style/FieldLabel" android:text="Prompt / style" android:layout_marginTop="12dp" />
                <EditText
                    android:id="@+id/editCaption"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:gravity="top"
                    android:hint="@string/hint_caption"
                    android:text="@string/default_caption"
                    android:textSize="14sp"
                    android:background="@color/chip_bg"
                    android:padding="10dp"
                    android:importantForAutofill="no" />

                <TextView style="@style/FieldLabel" android:text="Lyrics" android:layout_marginTop="12dp" />
                <EditText
                    android:id="@+id/editLyrics"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:gravity="top"
                    android:hint="@string/hint_lyrics"
                    android:text=""
                    android:textSize="14sp"
                    android:background="@color/chip_bg"
                    android:padding="10dp"
                    android:importantForAutofill="no" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Duration (seconds)"
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary" />
                    <EditText
                        android:id="@+id/editDuration"
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:text="30"
                        android:inputType="number"
                        android:textSize="14sp"
                        android:background="@color/chip_bg"
                        android:padding="8dp"
                        android:gravity="center" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Seed (-1 = random)"
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary" />
                    <EditText
                        android:id="@+id/editSeed"
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:text="-1"
                        android:inputType="numberSigned"
                        android:textSize="14sp"
                        android:background="@color/chip_bg"
                        android:padding="8dp"
                        android:gravity="center" />
                </LinearLayout>

                <!-- Explicit metadata: leave blank = let planner guess -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Music metadata (blank = auto)"
                    android:textSize="12sp"
                    android:textColor="@color/primary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="BPM"
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary" />
                    <EditText
                        android:id="@+id/editBpm"
                        android:layout_width="90dp"
                        android:layout_height="wrap_content"
                        android:hint="auto"
                        android:inputType="number"
                        android:textSize="14sp"
                        android:background="@color/chip_bg"
                        android:padding="8dp"
                        android:gravity="center" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Key / scale"
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary" />
                    <EditText
                        android:id="@+id/editKey"
                        android:layout_width="150dp"
                        android:layout_height="wrap_content"
                        android:hint="auto"
                        android:textSize="14sp"
                        android:background="@color/chip_bg"
                        android:padding="8dp"
                        android:gravity="center" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Time signature"
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary" />
                    <EditText
                        android:id="@+id/editTimesig"
                        android:layout_width="90dp"
                        android:layout_height="wrap_content"
                        android:hint="auto"
                        android:inputType="number"
                        android:textSize="14sp"
                        android:background="@color/chip_bg"
                        android:padding="8dp"
                        android:gravity="center" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchKeepCaption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:checked="true"
                    android:text="Keep my caption (recommended for vocals)"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="OFF lets the planner rewrite the style; it can drop ' vocal ' and suppress singing"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnGenerate"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/btn_generate"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp"
                    android:backgroundTint="@color/primary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Card: Status -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/divider"
            app:strokeWidth="1dp"
            app:contentPadding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView style="@style/SectionTitle" android:text="状态 Status" />

                <ProgressBar
                    android:id="@+id/progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:layout_marginTop="12dp" />

                <TextView
                    android:id="@+id/textStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/status_idle"
                    android:textSize="13sp"
                    android:textColor="@color/text_primary"
                    android:paddingTop="8dp"
                    android:minHeight="40dp" />

                <!-- In-app player -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Player" android:textSize="12sp"
                    android:textColor="@color/text_secondary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">

                    <Button
                        android:id="@+id/btnPlay"
                        android:layout_width="88dp"
                        android:layout_height="42dp"
                        android:text="Play"
                        android:textSize="13sp"
                        android:enabled="false"
                        android:backgroundTint="@color/accent" />

                    <SeekBar
                        android:id="@+id/playerSeek"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:enabled="false" />

                    <TextView
                        android:id="@+id/playerTime"
                        android:layout_width="78dp"
                        android:layout_height="wrap_content"
                        android:text="0:00 / 0:00"
                        android:textSize="11sp"
                        android:textColor="@color/text_secondary"
                        android:gravity="end" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
